{
  "waiters": {
    "dps.instance.running": {
      "commands": [
        "dps.instance.show"
      ],
      "path": "returnObj.ebmState",
      "success": "RUNNING",
      "failure": "ERROR",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "dps.instance.stopped": {
      "commands": [
        "dps.instance.show"
      ],
      "path": "returnObj.ebmState",
      "success": "STOPPED",
      "failure": "ERROR",
      "max_attempts": 60,
      "interval_seconds": 5
    }
  }
}
