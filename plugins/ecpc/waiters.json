{
  "waiters": {
    "ecpc.compute-desktop.hibernated": {
      "selector": {
        "path": "returnObj.list",
        "key": "desktopOid",
        "value": "$param.desktop_oid"
      },
      "commands": [
        "ecpc.compute-desktop.describe-ecs"
      ],
      "failure_values": [
        "Deleted"
      ],
      "path": "status",
      "success": "Hibernated",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.compute-desktop.running": {
      "selector": {
        "path": "returnObj.list",
        "key": "desktopOid",
        "value": "$param.desktop_oid"
      },
      "commands": [
        "ecpc.compute-desktop.describe-ecs"
      ],
      "failure_values": [
        "Deleted"
      ],
      "path": "status",
      "success": "Running",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.compute-desktop.stopped": {
      "selector": {
        "path": "returnObj.list",
        "key": "desktopOid",
        "value": "$param.desktop_oid"
      },
      "commands": [
        "ecpc.compute-desktop.describe-ecs"
      ],
      "failure_values": [
        "Deleted"
      ],
      "path": "status",
      "success": "Stopped",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.desktop.hibernated": {
      "selector": {
        "path": "returnObj.list",
        "key": "desktopOid",
        "value": "$param.desktop_oid"
      },
      "commands": [
        "ecpc.desktop.describe-desktops"
      ],
      "failure_values": [
        "Deleted"
      ],
      "path": "status",
      "success": "Hibernated",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.desktop.running": {
      "selector": {
        "path": "returnObj.list",
        "key": "desktopOid",
        "value": "$param.desktop_oid"
      },
      "commands": [
        "ecpc.desktop.describe-desktops"
      ],
      "failure_values": [
        "Deleted"
      ],
      "path": "status",
      "success": "Running",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.desktop.stopped": {
      "selector": {
        "path": "returnObj.list",
        "key": "desktopOid",
        "value": "$param.desktop_oid"
      },
      "commands": [
        "ecpc.desktop.describe-desktops"
      ],
      "failure_values": [
        "Deleted"
      ],
      "path": "status",
      "success": "Stopped",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.peering.active": {
      "commands": [
        "ecpc.peering.get-peering-info"
      ],
      "failure_values": [
        "3",
        "8"
      ],
      "path": "returnObj.status",
      "success": "7",
      "failure": "0",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.service.activated": {
      "commands": [
        "ecpc.service.check-desktop-service-status"
      ],
      "path": "returnObj.status",
      "success": "Activated",
      "failure": "",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.subnet.active": {
      "selector": {
        "path": "returnObj.list",
        "key": "subnetOid",
        "value": "$param.subnet_oid"
      },
      "commands": [
        "ecpc.subnet.describe-subnets"
      ],
      "path": "status",
      "success": "Active",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.volume.available": {
      "commands": [
        "ecpc.volume.detail-cloud-volume"
      ],
      "path": "returnObj.status",
      "success": "AVAILABLE",
      "failure": "",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.volume.in-use": {
      "commands": [
        "ecpc.volume.detail-cloud-volume"
      ],
      "path": "returnObj.status",
      "success": "INUSE",
      "failure": "",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "ecpc.vpc.active": {
      "selector": {
        "path": "returnObj.list",
        "key": "vpcOid",
        "value": "$param.vpc_oid"
      },
      "commands": [
        "ecpc.vpc.describe-vpcs"
      ],
      "path": "status",
      "success": "Active",
      "failure": "Unhealthy",
      "max_attempts": 60,
      "interval_seconds": 5
    }
  }
}
