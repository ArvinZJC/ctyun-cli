      "method": "POST",
      "path": "/ctapi/v1/tamperProtect/update",
      "content_type": "application/json",
      "body": {
        "backHost": "$param.back_host",
        "backPort": "$param.back_port",
        "domain": "$param.domain",
        "existCdn": "$param.exist_cdn",
        "id": "$param.id",
        "originIp": "$param.origin_ip",
        "productCode": "$param.product_code",
        "protectAct": "$param.protect_act",
        "protectType": "$param.protect_type",
        "requestProtocol": "$param.request_protocol",
        "ruleName": "$param.rule_name"
      },
      "retryable": false
    }
  }
}
