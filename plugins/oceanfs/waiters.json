{
  "waiters": {
    "oceanfs.file-system.available": {
      "commands": [
        "oceanfs.file-system.show",
        "oceanfs.file-system.show-by-name"
      ],
      "failure_values": [
        "unusable"
      ],
      "path": "returnObj.sfsStatus",
      "success": "available",
      "failure": "expired",
      "max_attempts": 60,
      "interval_seconds": 5
    }
  }
}
