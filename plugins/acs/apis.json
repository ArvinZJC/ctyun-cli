{
  "operations": {
    "v4.acs.flavor.list": {
      "method": "GET",
      "path": "/v4/ecs/lite/flavor-list",
      "content_type": "application/json",
      "query": {
        "azName": "$param.az_name",
        "regionID": "$profile.region"
      },
      "retryable": true
    },
    "v4.acs.instance.console.show": {
      "method": "GET",
      "path": "/v4/ecs/lite/vnc/details",
      "content_type": "application/json",
      "query": {
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": true
    },
    "v4.acs.instance.create": {
      "method": "POST",
      "path": "/v4/ecs/lite/create-instance",
      "content_type": "application/json",
      "body": {
        "autoRenewStatus": "$param.auto_renew_status",
        "bandwidth": "$param.bandwidth",
        "bootDiskSize": "$param.boot_disk_size",
        "clientToken": "$param.client_token",
        "cycleCount": "$param.cycle_count",
        "cycleType": "$param.cycle_type",
        "dataDiskList": "$param.data_disk_list",
        "displayName": "$param.display_name",
        "flavorName": "$param.flavor_name",
        "imageID": "$param.image_id",
        "ipVersion": "$param.ip_version",
        "orderCount": "$param.order_count",
        "regionID": "$profile.region",
        "securityProduct": "$param.security_product",
        "userPassword": "$param.user_password"
      },
      "retryable": false
    },
    "v4.acs.instance.delete": {
      "method": "POST",
      "path": "/v4/ecs/lite/unsubscribe",
      "content_type": "application/json",
      "body": {
        "clientToken": "$param.client_token",
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.list": {
      "method": "POST",
      "path": "/v4/ecs/lite/list",
      "content_type": "application/json",
      "body": {
        "pageNo": "$param.page_no",
        "pageSize": "$param.page_size",
        "regionID": "$profile.region"
      },
      "retryable": true
    },
    "v4.acs.instance.reboot": {
      "method": "POST",
      "path": "/v4/ecs/lite/reboot",
      "content_type": "application/json",
      "body": {
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.rebuild": {
      "method": "POST",
      "path": "/v4/ecs/lite/rebuild",
      "content_type": "application/json",
      "body": {
        "imageID": "$param.image_id",
        "instanceID": "$arg.instance_id",
        "password": "$param.password",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.renew": {
      "method": "POST",
      "path": "/v4/ecs/lite/resubscribe",
      "content_type": "application/json",
      "body": {
        "clientToken": "$param.client_token",
        "cycleCount": "$param.cycle_count",
        "cycleType": "$param.cycle_type",
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.reset-password": {
      "method": "POST",
      "path": "/v4/ecs/lite/reset-password",
      "content_type": "application/json",
      "body": {
        "instanceID": "$arg.instance_id",
        "newPassword": "$param.new_password",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.show": {
      "method": "GET",
      "path": "/v4/ecs/lite/details",
      "content_type": "application/json",
      "query": {
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": true
    },
    "v4.acs.instance.start": {
      "method": "POST",
      "path": "/v4/ecs/lite/start",
      "content_type": "application/json",
      "body": {
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.stop": {
      "method": "POST",
      "path": "/v4/ecs/lite/stop",
      "content_type": "application/json",
      "body": {
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.instance.update-flavor": {
      "method": "POST",
      "path": "/v4/ecs/lite/update-flavor",
      "content_type": "application/json",
      "body": {
        "bandwidth": "$param.bandwidth",
        "bootDiskSize": "$param.boot_disk_size",
        "clientToken": "$param.client_token",
        "flavorName": "$param.flavor_name",
        "instanceID": "$arg.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.volume.create": {
      "method": "POST",
      "path": "/v4/ecs/lite/create-volume",
      "content_type": "application/json",
      "body": {
        "clientToken": "$param.client_token",
        "diskCount": "$param.disk_count",
        "diskName": "$param.disk_name",
        "diskSize": "$param.disk_size",
        "diskType": "$param.disk_type",
        "instanceID": "$param.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    },
    "v4.acs.volume.delete": {
      "method": "POST",
      "path": "/v4/ecs/lite/unsubscribe-volume",
      "content_type": "application/json",
      "body": {
        "clientToken": "$param.client_token",
        "diskID": "$param.disk_id",
        "instanceID": "$param.instance_id",
        "regionID": "$profile.region"
      },
      "retryable": false
    }
  }
}
