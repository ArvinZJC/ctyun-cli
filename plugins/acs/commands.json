        {
          "name": "security_product",
          "flag": "security-product",
          "target": "securityProduct",
          "required": false,
          "allowed_values": [
            "EnterpriseEdition",
            "UltimateEdition",
            "BasicEdition",
            "false"
          ],
          "default": "false",
          "description": "Security protection edition; defaults to false"
        },
        {
          "name": "order_count",
          "flag": "order-count",
          "target": "orderCount",
          "required": false,
          "value_type": "integer",
          "default": "1",
