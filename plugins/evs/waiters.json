{
  "waiters": {
    "evs.snapshot.available": {
      "selector": {
        "path": "returnObj.snapshotList",
        "key": "snapshotID",
        "value": "$param.snapshot_id"
      },
      "commands": [
        "evs.snapshot.list"
      ],
      "failure_values": [
        "freezing"
      ],
      "path": "snapshotStatus",
      "success": "available",
      "failure": "error",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "evs.volume.available": {
      "commands": [
        "evs.volume.show",
        "evs.volume.show-by-name"
      ],
      "failure_values": [
        "errorRestoring",
        "realNameFreeze",
        "freezing",
        "expired",
        "volumeUnsubscribed"
      ],
      "path": "returnObj.diskStatus",
      "success": "available",
      "failure": "error",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "evs.volume.in-use": {
      "commands": [
        "evs.volume.show",
        "evs.volume.show-by-name"
      ],
      "failure_values": [
        "errorRestoring",
        "realNameFreeze",
        "freezing",
        "expired",
        "volumeUnsubscribed"
      ],
      "path": "returnObj.diskStatus",
      "success": "in-use",
      "failure": "error",
      "max_attempts": 60,
      "interval_seconds": 5
    },
    "evs.volume.ready": {
      "commands": [
        "evs.volume.show",
        "evs.volume.show-by-name"
      ],
      "success_values": [
        "in-use"
      ],
      "failure_values": [
        "errorRestoring",
        "realNameFreeze",
        "freezing",
        "expired",
        "volumeUnsubscribed"
      ],
      "path": "returnObj.diskStatus",
      "success": "available",
      "failure": "error",
      "max_attempts": 60,
      "interval_seconds": 5
    }
  }
}
